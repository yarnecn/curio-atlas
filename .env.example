# Application
NODE_ENV=development
WEB_PORT=3000
API_PORT=4000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
API_CORS_ORIGINS=http://localhost:3000

# PostgreSQL
POSTGRES_IMAGE=postgres:17-alpine
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=knowledge_map
POSTGRES_USER=knowledge_map
POSTGRES_PASSWORD=knowledge_map_dev
DATABASE_URL=postgresql://knowledge_map:knowledge_map_dev@localhost:5432/knowledge_map
DATABASE_POOL_MAX=5

# Redis / BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
AI_JOB_RECOVERY_INTERVAL_MS=30000
REDIS_URL=redis://localhost:6379

# AI runtime: the selected provider/model/base URL are managed at /admin/operations.
# Rules mode needs no key. Ollama runs locally. Remote OpenAI-compatible mode reads this server-only key.
AI_API_KEY=

# Source maintenance. Keep disabled until whitelist sources have been reviewed.
SOURCE_AUTOMATION_ENABLED=false
SOURCE_SCAN_INTERVAL_MS=300000
SOURCE_SCAN_BATCH_SIZE=10
SOURCE_DRAFT_BATCH_SIZE=5
SOURCE_FETCH_TIMEOUT_SECONDS=20
SOURCE_MAX_BYTES=2000000
PYTHON_BIN=python
# Optional absolute override used by packaged deployments.
CRAWLER_SCRIPT_PATH=

# Set true only when PostgreSQL/Redis are managed outside Docker.
SKIP_INFRA=false

# S3-compatible local object storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=knowledge-map-local
S3_ACCESS_KEY=knowledge_map
S3_SECRET_KEY=knowledge_map_dev_secret
S3_FORCE_PATH_STYLE=true
