{
  "name": "curio-atlas",
  "version": "0.0.0",
  "private": true,
  "description": "常识地图：面向成年人的通识重建与个人认知管理平台",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "content:status": "pnpm --filter @knowledge-map/database content-status",
    "start": "turbo run build --filter=@knowledge-map/api --filter=@knowledge-map/worker --filter=@knowledge-map/web && node scripts/serve-image.mjs config/app.config.json",
    "source:once": "pnpm --filter @knowledge-map/worker source:once",
    "image:build": "docker build --build-arg APP_VERSION=0.1.0 -t curio-atlas:0.1.0 .",
    "crawler:check": "node scripts/crawler-check.mjs",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "content:lint": "node scripts/content-lint.mjs",
    "content:catalog-check": "node scripts/content-catalog-check.mjs",
    "build": "turbo run build",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm content:lint && pnpm content:catalog-check && pnpm crawler:check && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.4.1",
    "eslint": "10.9.1",
    "globals": "^16.4.0",
    "turbo": "2.10.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.11"
  }
}
